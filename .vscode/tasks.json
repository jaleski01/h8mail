{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "H8MAIL: Start local workbench",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/Start-H8MAIL.ps1"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "H8MAIL: Build web application",
            "type": "shell",
            "command": "npm run build",
            "group": "build",
            "problemMatcher": "$tsc"
        }
    ]
}
