{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "excludeFiles": "{web/**,tests/**,tests_web/**,scripts/**,docs/**,node_modules/**,work/**}"
        }
    },
    "rewrites": [
        { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "no-referrer" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
            ]
        }
    ]
}
